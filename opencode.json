{
  "mcp": {
    "playwright": {
      "type": "local",
      "command": [
        "~/.claude/bin/playwright-mcp"
      ],
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": [
        "~/.claude/bin/chrome-devtools-mcp"
      ],
      "args": [
        "--autoConnect"
      ],
      "enabled": true
    }
  }
}
